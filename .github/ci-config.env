# .github/ci-config.env — Central CI configuration
# ──────────────────────────────────────────────────
# Edit THIS FILE to change containers, compiler targets, or MPI settings.
# Workflows and composite actions source this file; you should not need
# to edit YAML to change these values.


# ── Container images ──────────────────────────────
# CI jobs run inside Docker containers that ship pre-installed compilers,
# MPI libraries, and I/O libraries (NetCDF, PnetCDF, PIO).
#
# Two naming conventions are supported:
#
#   cisldev (legacy):
#     {REGISTRY}/cisldev-x86_64-{OS}-{compiler}-{mpi}:devel
#     Example: ncarcisl/cisldev-x86_64-almalinux9-gcc-openmpi:devel
#
#   hpcdev (new):
#     {REGISTRY}/hpcdev-x86_64:{OS}-{compiler}-{mpi}-{VERSION}
#     Example: ncarcisl/hpcdev-x86_64:almalinux9-gcc14-openmpi-26.02
#
# Both reduce to:  {CONTAINER_PREFIX}-{compiler}-{mpi}{CONTAINER_SUFFIX}
# Switch by changing CONTAINER_STYLE below.

CONTAINER_STYLE=hpcdev
CONTAINER_REGISTRY=docker.io/ncarcisl
CONTAINER_OS=almalinux9

# cisldev settings
CONTAINER_CISLDEV_TAG=devel

# hpcdev settings
CONTAINER_HPCDEV_VERSION=26.02


# ── Compiler names inside container images ────────
# The compiler portion of the image name varies between container styles.
# Map each compiler family to the name used in each style's image tags.
#
# Format: CONTAINER_COMPILER_{style}_{family}={image-name}
CONTAINER_COMPILER_cisldev_gcc=gcc
CONTAINER_COMPILER_cisldev_nvhpc=nvhpc
CONTAINER_COMPILER_cisldev_oneapi=oneapi

CONTAINER_COMPILER_hpcdev_gcc=gcc14
CONTAINER_COMPILER_hpcdev_nvhpc=nvhpc
CONTAINER_COMPILER_hpcdev_oneapi=oneapi


# ── MPI names inside container images ─────────────
# The MPI portion of the image name may also vary between styles.
# Workflows use canonical names (openmpi, mpich); these are mapped to
# the actual image tag component for each style.
#
# Format: CONTAINER_MPI_{style}_{canonical}={image-name}
CONTAINER_MPI_cisldev_openmpi=openmpi
CONTAINER_MPI_cisldev_mpich=mpich3

CONTAINER_MPI_hpcdev_openmpi=openmpi
CONTAINER_MPI_hpcdev_mpich=mpich


# ── Compiler → make target mapping ───────────────
# The MPAS Makefile uses named targets (e.g., `make gfortran CORE=atmosphere`)
# that don't always match the compiler family name used in CI matrix values.
#
# Format: MAKE_TARGET_{compiler}={makefile_target}
MAKE_TARGET_gcc=gfortran
MAKE_TARGET_nvhpc=nvhpc
MAKE_TARGET_oneapi=intel
MAKE_TARGET_clang=llvm


# ── NVHPC workarounds ────────────────────────────
# These compensate for known issues with NVHPC in containerized CI.
# They can be removed once the issues are resolved upstream.

# Target architecture flag prepended to NVHPC compiler flags.
# CI builds and runs happen on different hosts, so we need portable
# binaries. Without this, NVHPC defaults to -tp=native which generates
# instructions specific to the build host's CPU.
#   -tp=px     → portable x86-64 (safe default)
#   -tp=native → optimize for build host CPU (faster but may crash elsewhere)
NVHPC_TARGET_ARCH=-tp=px

# Extra flags passed to `make`. Disables MPI Fortran 2008 bindings which
# are broken in NVHPC versions before 24.x with MPICH4's default CFI support.
# See: https://github.com/pmodels/mpich/issues/6505
#   Set to empty string when containers upgrade to NVHPC 24.x+
NVHPC_EXTRA_MAKE_FLAGS="MPAS_MPI_F08=0"


# ── MPI runtime flags ────────────────────────────
# Flags and environment variables applied when running MPAS under MPI.
# These are needed because CI runs inside containers as root.

# OpenMPI refuses to run as root and limits processes to available cores
# by default. These flags override both restrictions.
OPENMPI_RUN_FLAGS="--allow-run-as-root --oversubscribe"

# MPICH's yaksa layer tries to initialize CUDA even when only stub
# libraries are present (no real GPU). These variables disable that.
# OpenACC GPU computation is unaffected.
# See: https://github.com/pmodels/mpich/issues/6523
MPICH_RUN_ENV_MPICH_GPU_SUPPORT_ENABLED=0
MPICH_RUN_ENV_MPIR_CVAR_ENABLE_GPU=0
