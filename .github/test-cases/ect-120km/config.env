#----------------------------------------------------------------------------
# ECT (Ensemble Consistency Test) configuration — 120km resolution
#
# Used by ect-ensemble-gen.yml and ect-test.yml workflows.
# See: Price-Broncucia et al. (2025), doi:10.5194/gmd-18-2349-2025
# PyCECT docs: https://pycect.readthedocs.io/en/latest/source/pyCECT.html
#----------------------------------------------------------------------------

# Test case data
RESOLUTION=120km
DATA_REPO=NCAR/mpas-ci-data

# Spin-up settings
# Hydrometeor fields are zero in cold-start init.nc; a 24h unperturbed
# run develops realistic values. The restart file from spin-up becomes
# the starting point for all perturbed ensemble members.
SPINUP_DURATION=1_00:00:00
SPINUP_TIMEOUT=350

# Model run settings (applied to each ensemble member, starting from restart)
# 2h36m = 13 time steps at the 12-min default dt, just past the ~12 step
# normality transition identified in Price-Broncucia et al. (2025).
RUN_DURATION=0_02:36:00
RUN_TIMEOUT=45

# PyCECT parameters
# The run-perturb-mpas action auto-detects the last time slice in each
# history file. In restart mode MPAS writes 1 slice (the forecast); in
# cold-start fallback it writes an extra initial-state slice first.
# Always using the last slice ensures we analyze the end-of-run forecast.
ECT_RAW_TSLICE=-1
ECT_TSLICE=0
ECT_ENSEMBLE_SIZE=200
ECT_TEST_RUNS=3

# Perturbation settings
# O(1e-14) matches the paper's recommendation and CESM convention.
# This magnitude requires double-precision builds (PRECISION=double);
# single-precision float32 epsilon (~1.2e-7) rounds away 1e-14 perturbations.
ECT_PERTURB_MAGNITUDE=1e-14
ECT_PERTURB_VARIABLE=theta

# PyCECT version (git tag from https://github.com/NCAR/PyCECT)
PYCECT_TAG=3.3.1

# Summary file naming
ECT_SUMMARY_PREFIX=mpas_ect_summary_120km
